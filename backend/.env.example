# ── App ───────────────────────────────────────────────────────────────────────
PROJECT_NAME=ZISUN Platform
ENVIRONMENT=development          # development | staging | production

# Pre-launch storefront: set to `browse` to open the catalogue publicly
# while ordering stays closed. RAZORPAY_* and TWILIO_* stop being required
# to boot, and every checkout endpoint returns 503. Delete this one line to
# restore the full fail-closed production behaviour. See DEPLOYMENT.md 1.5.
LAUNCH_MODE=

# ── RS256 JWT Keys ────────────────────────────────────────────────────────────
# Generate with: python scripts/generate_keys.py
# In .env, replace actual newlines with the literal two-char sequence \n
# Example: JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zisun_db
POSTGRES_PORT=5432
# Set to 1 when POSTGRES_SERVER is a TRANSACTION-mode pooler (Supabase
# Supavisor on :6543). Disables prepared-statement caching, which that
# pooler cannot support. Leave 0 for a direct host or SESSION mode (:5432).
DB_PGBOUNCER_MODE=0

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Twilio (SMS / OTP) ────────────────────────────────────────────────────────
# Leave blank in development — OTP will be printed to console instead
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+14155552671

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=zisun-media
CLOUDFLARE_CDN_BASE_URL=https://cdn.zisun.in

# ── Shiprocket ────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave blank in development — errors will appear in console only
SENTRY_DSN=
