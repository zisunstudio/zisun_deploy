# API origin, no trailing slash and no /api/v1 suffix (the suffix is added
# per-call). A value that already ends in /api/v1 is accepted too.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Razorpay public key (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Sentry (frontend)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=zisun-frontend
SENTRY_AUTH_TOKEN=

# Pre-launch: set to `browse` to match the API's LAUNCH_MODE=browse.
# Hides every add-to-cart and checkout entry point; catalogue stays public.
# Baked in at build time — changing it requires a REBUILD, not a restart.
NEXT_PUBLIC_LAUNCH_MODE=

# Digits only with country code, e.g. 919876543210. Powers the
# "order on WhatsApp" CTA shown while checkout is closed.
NEXT_PUBLIC_WHATSAPP_NUMBER=
